# ============================================================
# TGSHOPBOT – GITIGNORE (GitHub Upload Schutz)
# ============================================================
# Diese Datei stellt sicher, dass KEINE sensiblen Daten,
# API-Keys, lokalen Testumgebungs-Skripte oder Setup-Dateien
# öffentlich auf GitHub hochgeladen werden.
# ============================================================

# 1. Lokale Umgebungsdateien & API Keys (STRIKT IGNORIEREN)
.env
.env.local
.env.development
.env.production
.env.test
.env.*

# 2. Lokale Abhängigkeiten
node_modules/
/node_modules

# 3. Lokale Testskripte & Vorlagen für Entwicklung
start_local.bat

# 4. Lokaler JSON Dateispeicher (Entbundene Test-Datenbank)
.data/
/.data

# 5. Setup Ordner & Dokumentation (Nicht öffentlich pushen)
Setup/
/Setup


# 5. Log-Dateien & Crash-Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# 6. Betriebssystem & IDE Dateien
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
